# ROC8 + Lemonade portability appliance — PURE TheRock ROCm 7.13, zero /opt/rocm-7.2.4
# Card 124 ship/portability gate. Base: ubuntu:24.04.
#
# Build context must contain:
#   therock/   -> copy of gfx1201-7.13.0 (lib/ + lib/llvm/lib/)
#   llama/     -> build-tr713/bin (ROC8 binaries + libggml/libllama .so)
# Model is NOT baked (bind-mount at runtime, like any Lemonade model dir).
FROM docker.io/library/ubuntu:24.04

# ---- OS closure ----------------------------------------------------------
# libatomic1 is the ONLY OS package the llama.cpp binaries need beyond the
# ubuntu:24.04 base (libstdc++6/libgcc_s1 already present). numa/drm/elf are
# bundled by TheRock under lib/rocm_sysdeps; libomp comes from lib/llvm/lib.
# python3/venv/pip/curl are for the Lemonade server layer.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libatomic1 \
      python3 python3-venv python3-pip \
      curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ---- ROCm 7.13 runtime (TheRock) + ROC8 llama.cpp binaries ---------------
COPY therock/ /opt/therock/
COPY llama/   /opt/llama/

ENV LD_LIBRARY_PATH=/opt/llama:/opt/therock/lib:/opt/therock/lib/llvm/lib \
    HIP_VISIBLE_DEVICES=0 \
    PATH=/opt/venv/bin:/opt/llama:$PATH

# ---- Lemonade server (pip) + wire its rocm backend to our binaries -------
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir lemonade-sdk

# Point lemonade's rocm llama_server slot at OUR binaries so it never downloads
# the stock llamacpp-rocm build.
#
# The version marker must match whatever the INSTALLED lemonade expects. An
# earlier revision hardcoded 'b1066'; the currently-shipping lemonade expects
# b9747, so that literal was already stale -- and the failure mode is silent:
# lemonade sees a mismatch, downloads stock binaries, and the image builds and
# runs fine while no longer being The Rock8 at all.
#
# So: derive the marker from the installed package, then VERIFY the binary
# lemonade actually resolves is ours, and fail the build if it is not.
RUN set -eux; \
    SLOT="$(/opt/venv/bin/python -c 'import sys;print(sys.prefix)')/rocm/llama_server/build/bin"; \
    ROOT="$(dirname "$(dirname "$SLOT")")"; \
    mkdir -p "$SLOT"; \
    for f in /opt/llama/*; do ln -sf "$f" "$SLOT/$(basename "$f")"; done; \
    # lemond declares the llama.cpp build it wants in resources/backend_versions.json
    # and records what is installed in version.txt; when they disagree it REINSTALLS,
    # replacing our binaries with stock ones. So read the wanted version rather than
    # hardcoding it -- an earlier revision pinned the literal 'b1066', which was
    # already stale against the shipping SDK.
    BV="$(find / -name backend_versions.json -path '*resources*' 2>/dev/null | head -1)"; \
    test -n "$BV" || { echo "FATAL: backend_versions.json not found; cannot learn the wanted version"; exit 1; }; \
    VER="$(/opt/venv/bin/python -c "import json,sys; d=json.load(open('$BV'))['llamacpp']; print(d.get('rocm-stable') or d.get('rocm-nightly') or d.get('rocm'))")"; \
    test -n "$VER" -a "$VER" != None || { echo "FATAL: no llamacpp rocm version in $BV"; exit 1; }; \
    echo "lemond wants llama.cpp $VER; declaring that for our binaries"; \
    printf '%s' "$VER" > "$ROOT/version.txt"; \
    printf 'rocm'      > "$ROOT/backend.txt"; \
    # Verification -- the part that makes a silent swap impossible.
    readlink -f "$SLOT/llama-server" | grep -q '^/opt/llama/' \
      || { echo "FATAL: slot resolves outside /opt/llama; stock binaries would be used"; exit 1; }; \
    "$SLOT/llama-server" --version 2>&1 | head -2

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Lemonade default port
EXPOSE 13305
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["serve"]
