# ROC8 + Lemonade portability appliance — PURE TheRock ROCm 7.13, zero /opt/rocm-7.2.4
# Card 124 ship/portability gate. Base: ubuntu:24.04.
#
# Build context must contain:
#   therock/   -> copy of gfx1201-7.13.0 (lib/ + lib/llvm/lib/)
#   llama/     -> build-tr713/bin (ROC8 binaries + libggml/libllama .so)
# Model is NOT baked (bind-mount at runtime, like any Lemonade model dir).
FROM docker.io/library/ubuntu:24.04

# ---- OS closure ----------------------------------------------------------
# libatomic1 is the ONLY OS package the llama.cpp binaries need beyond the
# ubuntu:24.04 base (libstdc++6/libgcc_s1 already present). numa/drm/elf are
# bundled by TheRock under lib/rocm_sysdeps; libomp comes from lib/llvm/lib.
# python3/venv/pip/curl are for the Lemonade server layer.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libatomic1 \
      python3 python3-venv python3-pip \
      curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ---- ROCm 7.13 runtime (TheRock) + ROC8 llama.cpp binaries ---------------
COPY therock/ /opt/therock/
COPY llama/   /opt/llama/

ENV LD_LIBRARY_PATH=/opt/llama:/opt/therock/lib:/opt/therock/lib/llvm/lib \
    HIP_VISIBLE_DEVICES=0 \
    PATH=/opt/venv/bin:/opt/llama:$PATH

# ---- Lemonade server (pip) + wire its rocm backend to our binaries -------
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir lemonade-sdk

# Point lemonade's rocm llama_server slot at OUR binaries so it never downloads
# the stock llamacpp-rocm build.
#
# The version marker must match whatever the INSTALLED lemonade expects, and
# where that lives has now changed twice (hardcoded module constant -> a
# resources/backend_versions.json -> back to the module constant; the current
# SDK's backend_versions.json covers only FLM). Chasing file paths is what
# broke the previous revision of this step, so ask the SDK itself: its
# public helpers are the one interface that tracks these moves. The failure
# mode being defended against is silent -- on a marker mismatch lemonade
# re-downloads stock binaries and the image keeps building and running while
# no longer being The Rock8 at all -- hence the hard verification below.
RUN set -eux; \
    ROOT="$(/opt/venv/bin/python -c 'from lemonade.tools.llamacpp.utils import get_llama_folder_path; print(get_llama_folder_path("rocm"))')"; \
    VER="$(/opt/venv/bin/python -c 'from lemonade.tools.llamacpp.utils import get_llama_version; print(get_llama_version("rocm"))')"; \
    test -n "$ROOT" && test -n "$VER" || { echo "FATAL: lemonade SDK did not yield rocm folder/version"; exit 1; }; \
    SLOT="$ROOT/build/bin"; \
    mkdir -p "$SLOT"; \
    for f in /opt/llama/*; do ln -sf "$f" "$SLOT/$(basename "$f")"; done; \
    echo "lemonade wants llama.cpp $VER for rocm; declaring that for our binaries"; \
    printf '%s' "$VER" > "$ROOT/version.txt"; \
    printf 'rocm'      > "$ROOT/backend.txt"; \
    # Verification -- the part that makes a silent swap impossible.
    readlink -f "$SLOT/llama-server" | grep -q '^/opt/llama/' \
      || { echo "FATAL: slot resolves outside /opt/llama; stock binaries would be used"; exit 1; }; \
    "$SLOT/llama-server" --version 2>&1 | head -2

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Lemonade default port
EXPOSE 13305
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["serve"]
